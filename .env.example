# Supabase (Auth + Postgres/pgvector — file storage is R2, see below)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runtime LLM providers — only GOOGLE_API_KEY is required by default.
# Anthropic/OpenAI are optional fallbacks selectable per task type from the admin panel.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional free backups, used automatically (in this order) when Gemini can't
# answer, and selectable per task in Admin -> AI settings. Leave empty to skip.
# Groq: https://console.groq.com/keys  (text only)
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys  (free router; reads images too)
OPENROUTER_API_KEY=
# Mistral: https://console.mistral.ai/api-keys  (reads images too)
MISTRAL_API_KEY=
# Optional model overrides (defaults: openai/gpt-oss-120b, openrouter/free, mistral-small-latest)
GROQ_MODEL=
OPENROUTER_MODEL=
MISTRAL_MODEL=

# Cloudflare R2 (file storage: scanned source pages + generated PDFs).
# Free tier: 10GB storage, zero egress fees — chosen because every uploaded
# page's image is kept and re-served on every generation that cites it.
# Dashboard: https://dash.cloudflare.com -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=syllabi

# Private testing (see src/lib/access.ts). While OPEN_SIGNUPS is not "true",
# only ADMIN_EMAIL can sign up and only admin accounts can use the app.
# Set OPEN_SIGNUPS=true and redeploy to open sign-ups to parents and tutors.
ADMIN_EMAIL=
OPEN_SIGNUPS=false
