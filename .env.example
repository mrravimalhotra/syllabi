# Supabase (Auth + Postgres/pgvector — file storage is R2, see below)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runtime LLM providers — only GOOGLE_API_KEY is required by default.
# Anthropic/OpenAI are optional fallbacks selectable per task type from the admin panel.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cloudflare R2 (file storage: scanned source pages + generated PDFs).
# Free tier: 10GB storage, zero egress fees — chosen because every uploaded
# page's image is kept and re-served on every generation that cites it.
# Dashboard: https://dash.cloudflare.com -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=syllabi
